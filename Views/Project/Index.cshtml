@model IEnumerable<TicketTracking.Models.Project>

@{
    ViewData["Title"] = "Projeler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Projeler</h2>
        <p class="text-muted small mb-0">Destek taleplerinin toplandığı sistem projeleri.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-folder-plus me-1"></i> Yeni Proje Ekle
    </a>
</div>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info text-center py-4">
                Kayıtlı proje bulunmamaktadır. Yeni bir proje oluşturarak başlayabilirsiniz.
            </div>
        </div>
    }
    else
    {
        @foreach (var project in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold text-dark">@project.Name</h5>
                        <p class="card-text text-muted flex-grow-1 small">
                            @(string.IsNullOrWhiteSpace(project.Description) ? "Açıklama girilmemiş." : project.Description)
                        </p>
                        <div class="border-top pt-3 mt-2 d-flex justify-content-between align-items-center">
                            <small class="text-muted">@project.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</small>
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@project.Id" class="btn btn-outline-primary">Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@project.Id" class="btn btn-outline-danger">Sil</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>