@model TicketTracking.Models.Ticket

@{
    ViewData["Title"] = "Yeni Talep Oluştur";
}

<h2>Yeni Destek Talebi Oluştur</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <!-- Kırmızı kutu sadece gerçekten bir hata varsa görünür -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>
            }

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Başlık</label>
                <input asp-for="Title" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="ProjectId" class="form-label">Bağlı Proje</label>
                <select asp-for="ProjectId" class="form-select" asp-items="ViewBag.ProjectId" required>
                    <option value="">-- Proje Seçiniz --</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Type" class="form-label">Talep Türü</label>
                <select asp-for="Type" class="form-select">
                    <option value="Hata">Hata (Bug)</option>
                    <option value="Geliştirme">Geliştirme (Feature)</option>
                    <option value="İyileştirme">İyileştirme (Improvement)</option>
                    <option value="Destek">Destek</option>
                </select>
        </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Priority" class="form-label">Öncelik</label>
                    <select asp-for="Priority" class="form-select">
                        <option value="Dusuk">Düşük</option>
                        <option value="Orta" selected>Orta</option>
                        <option value="Yuksek">Yüksek</option>
                        <option value="Kritik">Kritik</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Status" class="form-label">Durum</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Acik" selected>Açık</option>
                        <option value="Inceleniyor">İnceleniyor</option>
                        <option value="Cozuldu">Çözüldü</option>
                        <option value="Kapatildi">Kapatıldı</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="btn btn-success">Oluştur</button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </form>
    </div>
</div>