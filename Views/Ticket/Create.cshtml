@model TicketTracking.Models.Ticket

@{
    ViewData["Title"] = "Yeni Talep Oluştur";
}

<h2>Yeni Destek Talebi Oluştur</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <!-- Genel hata özeti kutusu -->
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>
        }

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label asp-for="Title" class="form-label">Başlık</label>
                <input asp-for="Title" class="form-control" placeholder="Örn: Login ekranında hata oluşuyor" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Hatanın veya talebin detaylarını açıklayın..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ProjectId" class="form-label">Bağlı Proje</label>
                <select asp-for="ProjectId" class="form-select" asp-items="ViewBag.ProjectId">
                    <option value="">-- Proje Seçiniz --</option>
                </select>
                <span asp-validation-for="ProjectId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Type" class="form-label">Talep Türü</label>
                <select asp-for="Type" class="form-select">
                    <option value="Hata">Hata</option>
                    <option value="Talep">Talep</option>
                    <option value="Soru">Soru</option>
                </select>
                <span asp-validation-for="Type" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Priority" class="form-label">Öncelik</label>
                <select asp-for="Priority" class="form-select">
                    <option value="Dusuk">Düşük</option>
                    <option value="Orta" selected>Orta</option>
                    <option value="Yuksek">Yüksek</option>
                </select>
                <span asp-validation-for="Priority" class="text-danger small"></span>
            </div>

            <!-- Aşama 23: Tamamen Türkçe Özel Dosya Seçim Alanı -->
            <div class="mb-3">
                <label class="form-label">Ek Dosya / Ekran Görüntüsü (Opsiyonel)</label>
                <div class="input-group">
                    <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('attachmentInput').click();">
                        <i class="bi bi-paperclip me-1"></i> Dosya Seç
                    </button>
                    <input type="text" id="fileNameDisplay" class="form-control bg-white" placeholder="Dosya seçilmedi" readonly />
                </div>
                <!-- Arka planda çalışan gerçek dosya girdisi -->
                <input type="file" id="attachmentInput" name="attachment" class="d-none" onchange="document.getElementById('fileNameDisplay').value = this.files[0] ? this.files[0].name : 'Dosya seçilmedi';" />
                <div class="form-text">Desteklenen: .png, .jpg, .log, .pdf vb.</div>
            </div>

            <button type="submit" class="btn btn-primary">Talebi Oluştur</button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}