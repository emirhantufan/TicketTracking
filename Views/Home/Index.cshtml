@model TicketTracking.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Gösterge Paneli";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Gösterge Paneli</h2>
        <p class="text-muted small mb-0">Sistem genelindeki talep durumları, projeler ve özet istatistikler.</p>
    </div>
    <a asp-controller="Ticket" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Yeni Talep Aç
    </a>
</div>

<!-- 4 Temel İstatistik Kartı -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-subtitle mb-1 text-white-50">Toplam Talep</h6>
                    <h2 class="card-title fw-bold mb-0">@Model.TotalTickets</h2>
                </div>
                <i class="bi bi-card-checklist fs-1 text-white-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-subtitle mb-1 text-white-50">Açık Talepler</h6>
                    <h2 class="card-title fw-bold mb-0">@Model.OpenTickets</h2>
                </div>
                <i class="bi bi-envelope-open fs-1 text-white-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-secondary text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-subtitle mb-1 text-white-50">Kapatılan Talepler</h6>
                    <h2 class="card-title fw-bold mb-0">@Model.ClosedTickets</h2>
                </div>
                <i class="bi bi-check2-circle fs-1 text-white-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-dark text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-subtitle mb-1 text-white-50">Toplam Proje</h6>
                    <h2 class="card-title fw-bold mb-0">@Model.TotalProjects</h2>
                </div>
                <i class="bi bi-folder2 fs-1 text-white-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Grafikler Alanı -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">Durum Dağılımı (Açık vs Kapatıldı)</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="position: relative; height:260px;">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">Tür Dağılımı (Hata / Talep / Soru)</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="position: relative; height:260px;">
                <canvas id="typeChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Son Eklenen Talepler Tablosu -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold">Son Eklenen Talepler</h6>
        <a asp-controller="Ticket" asp-action="Index" class="btn btn-sm btn-outline-primary">Tümünü Gör</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">#ID</th>
                    <th>Başlık</th>
                    <th>Proje</th>
                    <th>Tür</th>
                    <th>Durum</th>
                    <th>Tarih</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RecentTickets.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-3 text-muted">Henüz kayıtlı talep yok.</td>
                    </tr>
                }
                else
                {
                    @foreach (var ticket in Model.RecentTickets)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@ticket.Id</td>
                            <td>
                                <a asp-controller="Ticket" asp-action="Details" asp-route-id="@ticket.Id" class="text-decoration-none fw-semibold text-dark">
                                    @ticket.Title
                                </a>
                            </td>
                            <td><span class="badge bg-light text-dark border">@(ticket.Project?.Name ?? "Genel")</span></td>
                            <td><span class="badge bg-info-subtle text-info-emphasis border">@ticket.Type</span></td>
                            <td>
                                @if (ticket.Status == TicketTracking.Models.TicketStatus.Kapatildi)
                                {
                                    <span class="badge bg-secondary">Kapatıldı</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Açık</span>
                                }
                            </td>
                            <td class="small text-muted">@ticket.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 1. Durum Dağılımı Grafiği (Doughnut)
        const ctxStatus = document.getElementById('statusChart').getContext('2d');
        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: ['Açık', 'Kapatıldı'],
                datasets: [{
                    data: [@Model.OpenTickets, @Model.ClosedTickets],
                    backgroundColor: ['#198754', '#6c757d'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });

        // 2. Tür Dağılımı Grafiği (Bar)
        const ctxType = document.getElementById('typeChart').getContext('2d');
        new Chart(ctxType, {
            type: 'bar',
            data: {
                labels: ['Hata (Bug)', 'Talep', 'Soru'],
                datasets: [{
                    label: 'Talep Sayısı',
                    data: [@Model.BugCount, @Model.RequestCount, @Model.QuestionCount],
                    backgroundColor: ['#dc3545', '#0d6efd', '#0dcaf0'],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    </script>
}